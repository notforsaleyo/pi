# Track only authored configuration; everything else is ignored by default.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/settings.json
!/keybindings.json
!/open-tui.json
!/extensions/
!/local-packages/
!/skills/
!/backlog/

# Conversations are never backed up.
sessions/
*.jsonl

# Credentials, caches, installs and machine-local state.
auth.json
*.db
*.db-*
node_modules/
npm/
bin/
backups/
usage-cache.json
models-store.json
.env
.env.*
*.log
*.tmp

# Installed and managed by herdr; not everyone uses herdr.
extensions/herdr-agent-state.ts
