{
  "icons": {
    "mode": "nerd",
    "cwd": "",
    "ahead": "",
    "behind": ""
  },
  "components": {
    "editor": {
      "enabled": false,
      "style": "opencode",
      "colors": {
        "thinkingLow": "green",
        "thinkingMedium": "cyan",
        "thinkingHigh": "bold yellow",
        "thinkingXhigh": "bold #ff0000",
        "thinkingMax": "bold underline #ff00ff"
      }
    },
    "userMessages": {
      "enabled": false,
      "style": "framed"
    },
    "thinkingSteps": {
      "enabled": false,
      "mode": "streaming"
    },
    "extensionStatuses": {
      "visibility": {
        "provider-usage": "hide"
      }
    },
    "footer": {
      "style": "starship",
      "colorSource": "theme",
      "styles": {
        "starship": {
          "format": "$cwd(  $git_branch)( $git_status)( $git_state)$fill$model($sep$provider)($sep$thinkingLevel)($sep$context)($sep$tokens)",
          "responsive": true,
          "compactFormat": "$cwd$wrap($git_branch $git_status $git_state)$fill$model$wrap_sep($provider)$wrap_sep($thinkingLevel)$wrap_sep($context)$wrap_sep($tokens)",
          "compactMaxLines": 2,
          "separator": "pipe"
        }
      }
    }
  }
}
